{
  "expo": {
    "name": "EasyGo",
    "slug": "easygo",
    "scheme": "coineasyapp",
    "owner": "coineasy",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo_easygo_1024.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash_easygo.png",
      "resizeMode": "cover",
      "backgroundColor": "#FFF8F0"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "icon": "./assets/logo_easygo_ios_1024.png",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "buildNumber": "92",
      "bundleIdentifier": "com.coineasy.coineasysocial",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "EasyGo uses your photo library when you choose a profile image or attach media to a post.",
        "NSPhotoLibraryAddUsageDescription": "EasyGo saves media to your photo library only when you choose to download it.",
        "NSCameraUsageDescription": "EasyGo uses the camera only when you choose to take a photo for a post.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 64,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo_easygo_1024.png",
        "backgroundColor": "#FFF8F0"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.USE_FULL_SCREEN_INTENT"
      ],
      "googleServicesFile": "./google-services.json",
      "package": "com.coineasy.coineasy"
    },
    "web": {
      "favicon": "./assets/logo_easygo_1024.png"
    },
    "plugins": [
      [
        "expo-apple-authentication"
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "EasyGo uses your photo library when you choose a profile image or attach media to a post.",
          "cameraPermission": "EasyGo uses the camera only when you choose to take a photo for a post.",
          "microphonePermission": false
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "EasyGo uses your photo library when you choose media to share.",
          "savePhotosPermission": "EasyGo saves media to your photo library only when you choose to download it.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-font",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "2297c440-2ab1-46d8-8c60-29e74977ed9f"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2297c440-2ab1-46d8-8c60-29e74977ed9f"
    }
  }
}
