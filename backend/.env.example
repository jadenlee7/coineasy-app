# EasyGo backend — Phase 1 (Path C)
# Copy to .env and fill in. Never commit the real .env.

# --- Server ---
NODE_ENV=development
EASYGO_DEPLOY_TARGET=local
PORT=3000
LOG_LEVEL=debug
SERVICE_NAME=easygo-backend
# Immutable deployment identifier (usually the git commit SHA).
RELEASE_SHA=local
READINESS_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=10000

# --- Optional observability (Path C v2 S9; disabled when blank) ---
# Server-side Sentry project. Request/user PII is stripped before sending.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
# Defaults to 0 and is capped at 0.2 by the application.
SENTRY_TRACES_SAMPLE_RATE=0
# Configure both Better Stack values or neither. Use per-service source tokens.
BETTER_STACK_SOURCE_TOKEN=
BETTER_STACK_INGESTING_HOST=

# --- Database (Postgres) ---
# Example local: postgresql://easygo:easygo@localhost:5432/easygo?schema=public
DATABASE_URL=
# Required only when intentionally seeding a non-local development database.
ALLOW_DEMO_SEED=false

# --- Privy (auth + embedded wallet) ---
# Get from https://dashboard.privy.io
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# --- SIWE wallet verification (Path C v2 S1; disabled by default) ---
SIWE_AUTH_ENABLED=false
SIWE_DOMAIN=
SIWE_URI=
SIWE_STATEMENT=Sign in to EasyGo and verify ownership of this wallet.
BASE_RPC_URL=https://mainnet.base.org

# --- Consent + privacy controls (Path C v2 S3) ---
# Must match the published policy/terms version before production starts.
# Production returns 503 from consent routes while this is blank.
EASYGO_CONSENT_VERSION=
# Grant/permission expansion stays off until matched EasyGo legal documents and
# App Store disclosures are approved. Revocation remains available while off.
CONSENT_GRANTS_ENABLED=false
# Keep destructive deletion off until cross-user reply ownership and
# post-deletion Privy session recreation have an approved implementation.
ACCOUNT_DELETION_ENABLED=false

# --- ENS subname issuance (Path C v2 S4; disabled by default) ---
JUSTANAME_ENABLED=false
# Server-only key for the coineasy.eth workspace. Never expose to Expo.
JUSTANAME_API_KEY=
JUSTANAME_ENS_DOMAIN=coineasy.eth
# SIWE authority + URI used by JustaName's two-minute challenge.
JUSTANAME_DOMAIN=
JUSTANAME_ORIGIN=
# JustaName issues .eth subnames on Ethereum mainnet; Base is an address record.
JUSTANAME_CHAIN_ID=1

# --- Consent-gated segment worker (Path C v2 S5; disabled by default) ---
SEGMENTS_ENABLED=false
# Run as a separate service: npm run worker:segments
SEGMENT_WORKER_INTERVAL_MS=300000
SEGMENT_WORKER_BATCH_SIZE=100
SEGMENT_WORKER_CONCURRENCY=2
SEGMENT_REQUEST_TIMEOUT_MS=10000
# Official EFP public API; only current follower/following counts are read.
EFP_API_URL=https://api.ethfollow.xyz/api/v1
# Server-only. Required only by time-windowed Base activity rules.
ETHERSCAN_API_URL=https://api.etherscan.io/v2/api
ETHERSCAN_API_KEY=

# --- Server-verified quests (Path C v2 S6; disabled by default) ---
QUESTS_ENABLED=false
# Transaction quests reuse BASE_RPC_URL above and remain fixed to Base mainnet.
# Keep every seeded quest in DRAFT until content, reward, consent copy, and RPC
# capacity have been reviewed.

# --- Aggregate-only advertiser admin (Path C v2 S7; disabled by default) ---
ADVERTISER_ADMIN_ENABLED=false
# JSON object: advertiser slug -> lowercase SHA-256 digest of its high-entropy
# `eg_adv_...` Bearer key. Never store raw advertiser keys here.
ADVERTISER_API_KEY_HASHES_JSON=
# User-derived counts below this threshold are returned as suppressed nulls.
# Values below 10 are ignored and safely fall back to 10.
ADVERTISER_AGGREGATE_MINIMUM=10

# --- Staged legacy social retirement (Path C v2 S8; active by default) ---
# active: reads+writes; read_only: reads only; retired: all social routes 410.
# Invalid or missing values safely fall back to active.
LEGACY_SOCIAL_MODE=active
# Extra preflight approval required before staging deploys a non-active mode.
ALLOW_LEGACY_SOCIAL_RETIREMENT=false
# Informational ISO-8601 timestamp returned by /social/status and 410 bodies.
LEGACY_SOCIAL_SUNSET_AT=

# --- Squid (cross-chain swap) ---
# Phase 1 chain target: Base (chainId 8453)
SQUID_INTEGRATOR_ID=
SQUID_API_URL=https://apiplus.squidrouter.com

# --- Telegram ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Webhook URL (prod). Leave empty in dev to use long-poll.
TELEGRAM_WEBHOOK_URL=
# Random string used as path component to gate webhook hits.
TELEGRAM_WEBHOOK_SECRET=

# --- Squid Korea text AMA (disabled by default) ---
# Turn on only after the migration is deployed and /ama_preflight returns GO.
AMA_CAMPAIGN_ENABLED=false
AMA_CAMPAIGN_ID=squid_ama_2026_08_05
# Numeric supergroup ID, normally beginning with -100. Do not use @squid_kor.
AMA_CHAT_ID=
AMA_CHAT_USERNAME=squid_kor
AMA_ROOM_URL=https://t.me/squid_kor
# Fig's numeric Telegram user ID. Fig remains a permanent Squid admin;
# the Bot checks that status but never promotes, demotes, or removes Fig.
AMA_SPEAKER_TELEGRAM_ID=
# Comma-separated numeric Telegram user IDs allowed to run /ama_* operations.
AMA_OPERATOR_TELEGRAM_IDS=
# Internal/test/speaker IDs excluded from bulk AMA DMs.
AMA_DM_EXCLUDED_TELEGRAM_IDS=
# Sequential send delay. 50ms stays below Telegram's usual global throughput.
AMA_DM_DELAY_MS=50
# Optional; discovered through getMe() when blank.
AMA_BOT_USERNAME=
# 5 Aug 2026, 20:00–20:30 KST / 12:00–12:30 UK / 15:00–15:30 Dubai.
AMA_START_AT=2026-08-05T11:00:00Z
AMA_END_AT=2026-08-05T11:30:00Z
# Defaults to five minutes after AMA_END_AT when blank.
AMA_FAILSAFE_RESTORE_AT=2026-08-05T11:35:00Z
AMA_QUESTION_LIMIT=3
AMA_PREPARED_QUESTION_COUNT=5
AMA_LIGHTNING_QUESTION_COUNT=5
AMA_XP_QUESTION=20
AMA_XP_LIVE_CHECKIN=15
AMA_XP_QUALIFIED_REFERRAL=30
AMA_QUALIFIED_REFERRAL_LIMIT=10
# Server-side only. Responses are requested with store=false.
OPENAI_API_KEY=
AMA_TRANSLATION_MODEL=

# --- Internal admin (server-trusted earn endpoint) ---
ADMIN_SECRET=

# --- Phase 2 (deferred) ---
# Activated only when PHASE.EASYCHAIN_ENABLED flips true in utils/easygo.js.
# Leave blank in Phase 1.
EASYCHAIN_RPC_URL=
EASYCHAIN_CHAIN_ID=

# --- Read-only post-deploy smoke runner (operator shell only) ---
EASYGO_BASE_URL=
EXPECTED_RELEASE=
