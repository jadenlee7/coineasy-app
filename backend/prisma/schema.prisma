// Prisma schema for EasyGo Phase 1 backend.
//
// Path C: chain-agnostic at the model level. `walletAddress` and
// `SwapLog.chainId` are strings so we can flip from Base (8453) to
// EasyChain in Phase 2 without a destructive migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String  @id @default(cuid())
  privyDid         String  @unique
  telegramId       String? @unique
  telegramUsername String?
  kakaoId          String? @unique
  walletAddress    String? @unique

  // --- SIWE wallet verification (Path C v2 S1) --------------------
  // Nonces are short-lived, hashed, and bound to both user and address.
  verifiedAddress    String?   @unique
  siweChainId        Int?
  siweVerifiedAt     DateTime?
  siweNonceHash      String?
  siweNonceAddress   String?
  siweNonceExpiresAt DateTime?
  // ------------------------------------------------------------------

  // --- ENS subname issuance (Path C v2 S4) --------------------------
  // The name is issued on Ethereum mainnet by JustaName, while the same
  // verified EVM address is also stored under the Base ENSIP-19 coin type.
  subname                   String?          @unique
  subnameStatus             EnsSubnameStatus @default(NOT_REQUESTED)
  subnameAddress            String?
  subnameChainId            Int?
  subnameRequestedAt        DateTime?
  subnameIssuedAt           DateTime?
  subnameChallengeHash      String?
  subnameChallengeExpiresAt DateTime?
  // ------------------------------------------------------------------

  // --- Social profile (PR #9) ---------------------------------------
  // username: optional, unique handle. Lowercase enforced at app layer.
  // displayName: free-form display name shown in UI.
  // pfp: URL to avatar (media upload deferred to PR #10).
  // bio: short user-written description.
  username    String? @unique
  displayName String?
  pfp         String?
  bio         String?
  // ------------------------------------------------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledger OrangeLedger[]
  swaps  SwapLog[]

  // Social relations (PR #9)
  posts     Post[]   @relation("PostAuthor")
  likes     Like[]
  following Follow[] @relation("Follower")
  followers Follow[] @relation("Followee")

  // Path C v2 ownership. All user-owned privacy/targeting records are
  // removed by the future S3 account-forget flow.
  consent          UserConsent?
  consentAudits    UserConsentAudit[]
  questCompletions QuestCompletion[]
  segments         UserSegment[]

  // Server-derived, keyed digests of stable upstream identities. Raw
  // provider subjects and emails are never stored. The generic provider +
  // context namespace lets later providers join the same deletion guard.
  stableProviderIdentities UserStableProviderIdentity[]
}

enum AccountDeletionState {
  REQUESTED
  LOCAL_PURGED
  APPLE_REVOKED
  PRIVY_DELETED
  COMPLETED
  MANUAL_REVIEW
}

enum AccountDeletionReauthStatus {
  ISSUED
  ATTESTED
  CONSUMED
}

// Short-lived proof that a fresh Apple interaction matched both the current
// Privy session and the stable Apple identity already bound to the account.
// Raw DIDs, session IDs, client request IDs, Apple subjects, JWTs, nonce/state,
// and bearer proofs are never persisted.
model AccountDeletionReauthChallenge {
  id                       String                      @id @default(cuid())
  subjectHash              String                      @db.Char(64)
  subjectHashKeyVersion    Int                         @default(1)
  subjectHashKeyFingerprint String                     @db.Char(64)
  sessionHash              String                      @db.Char(64)
  clientRequestHash        String                      @db.Char(64)
  nonceHash                String                      @db.Char(64)
  stateHash                String                      @db.Char(64)
  providerIdentityHash     String?                     @db.Char(64)
  proofHash                String?                     @unique @db.Char(64)
  status                   AccountDeletionReauthStatus @default(ISSUED)
  expiresAt                DateTime                    @db.Timestamptz(3)
  attestedAt               DateTime?                   @db.Timestamptz(3)
  consumedAt               DateTime?                   @db.Timestamptz(3)
  createdAt                DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                    @updatedAt @db.Timestamptz(3)

  subjectKey      AccountDeletionKeyRegistry @relation("AccountDeletionReauthSubjectKey", fields: [subjectHashKeyVersion, subjectHashKeyFingerprint], references: [keyVersion, fingerprint], onDelete: Restrict, onUpdate: Restrict, map: "AccountDeletionReauthChallenge_subject_key_fkey")
  deletionRequest AccountDeletionRequest?      @relation("AccountDeletionRequestReauth")

  @@index([subjectHash, sessionHash, status, expiresAt], map: "idx_deletion_reauth_binding")
  @@index([expiresAt], map: "idx_deletion_reauth_expiry")
}

// Pins each HMAC key version to one non-secret keyed fingerprint. Concurrent
// first users race through INSERT ... ON CONFLICT DO NOTHING, then compare the
// winner, so an accidental secret replacement fails closed without globally
// serializing every auth sync.
model AccountDeletionKeyRegistry {
  keyVersion                 Int                               @id
  fingerprint                String                            @unique @db.Char(64)
  createdAt                  DateTime                          @default(now())
  deletionRequests           AccountDeletionRequest[]          @relation("AccountDeletionSubjectKey")
  userProviderIdentities     UserStableProviderIdentity[]      @relation("UserStableProviderIdentityKey")
  deletionProviderIdentities AccountDeletionProviderIdentity[] @relation("AccountDeletionProviderIdentityKey")
  reauthChallenges           AccountDeletionReauthChallenge[]   @relation("AccountDeletionReauthSubjectKey")

  @@unique([keyVersion, fingerprint])
}

// Durable tombstone for the cross-provider account-deletion saga. This model
// intentionally has no User relation: it must survive removal of the User row
// to block stale Privy sessions from recreating the account.
model AccountDeletionRequest {
  id                        String               @id @default(cuid())
  subjectHash               String               @unique @db.Char(64)
  subjectHashKeyVersion     Int                  @default(1)
  subjectHashKeyFingerprint String               @db.Char(64)
  privyDidCiphertext        String?              @db.Text
  encryptionKeyVersion      Int?
  clientRequestId           String               @db.Uuid
  recentAuthChallengeId     String?              @unique
  state                     AccountDeletionState @default(REQUESTED)
  stateVersion              Int                  @default(0)
  attemptCount              Int                  @default(0)
  nextAttemptAt             DateTime?
  lastAttemptAt             DateTime?
  lastErrorAt               DateTime?
  lastErrorCode             String?              @db.VarChar(100)
  leaseToken                String?              @db.VarChar(64)
  leaseExpiresAt            DateTime?
  requestedAt               DateTime             @default(now())
  localPurgedAt             DateTime?
  appleRevokedAt            DateTime?
  privyDeletedAt            DateTime?
  completedAt               DateTime?
  manualReviewAt            DateTime?
  updatedAt                 DateTime             @updatedAt

  subjectKey         AccountDeletionKeyRegistry        @relation("AccountDeletionSubjectKey", fields: [subjectHashKeyVersion, subjectHashKeyFingerprint], references: [keyVersion, fingerprint], onDelete: Restrict, onUpdate: Restrict, map: "AccountDeletionRequest_subject_key_fkey")
  providerIdentities AccountDeletionProviderIdentity[]
  recentAuthChallenge AccountDeletionReauthChallenge?   @relation("AccountDeletionRequestReauth", fields: [recentAuthChallengeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "AccountDeletionRequest_recent_auth_fkey")

  @@index([clientRequestId])
  @@index([state, nextAttemptAt])
  @@index([leaseExpiresAt])
}

// Active ownership of a stable upstream provider identity. A provider identity
// may belong to only one local User at a time. Rows are append-only in place;
// they are deleted only by the User cascade after a durable deletion identity
// has been created in AccountDeletionProviderIdentity.
model UserStableProviderIdentity {
  id                   String   @id @default(cuid())
  userId               String
  provider             String   @db.VarChar(64)
  context              String   @db.VarChar(128)
  providerIdentityHash String   @db.Char(64)
  keyVersion           Int      @default(1)
  keyFingerprint       String   @db.Char(64)
  createdAt            DateTime @default(now())

  user       User                       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  subjectKey AccountDeletionKeyRegistry @relation("UserStableProviderIdentityKey", fields: [keyVersion, keyFingerprint], references: [keyVersion, fingerprint], onDelete: Restrict, onUpdate: Restrict, map: "UserStableProviderIdentity_subject_key_fkey")

  @@unique([provider, context, providerIdentityHash], map: "uniq_user_stable_provider_identity")
  @@unique([userId, provider, context], map: "uniq_user_stable_provider_namespace")
  @@index([userId], map: "idx_user_stable_provider_user")
}

// Durable, provider-generic tombstone identity. It survives local User purge
// and lets a new Privy DID carrying the same upstream subject recover or block
// the original deletion request without persisting the raw subject.
model AccountDeletionProviderIdentity {
  id                       String   @id @default(cuid())
  accountDeletionRequestId String
  provider                 String   @db.VarChar(64)
  context                  String   @db.VarChar(128)
  providerIdentityHash     String   @db.Char(64)
  keyVersion               Int      @default(1)
  keyFingerprint           String   @db.Char(64)
  createdAt                DateTime @default(now())

  request    AccountDeletionRequest     @relation(fields: [accountDeletionRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "AccountDeletionProviderIdentity_request_fkey")
  subjectKey AccountDeletionKeyRegistry @relation("AccountDeletionProviderIdentityKey", fields: [keyVersion, keyFingerprint], references: [keyVersion, fingerprint], onDelete: Restrict, onUpdate: Restrict, map: "AccountDeletionProviderIdentity_subject_key_fkey")

  @@unique([provider, context, providerIdentityHash], map: "uniq_deletion_stable_provider_identity")
  @@unique([accountDeletionRequestId, provider, context], map: "uniq_deletion_request_provider_namespace")
  @@index([accountDeletionRequestId], map: "idx_deletion_provider_request")
}

model OrangeLedger {
  id        String   @id @default(cuid())
  userId    String
  delta     Int
  reason    String
  refId     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reason, refId], map: "uniq_ledger_reason_ref")
  @@index([userId, createdAt])
}

model SwapLog {
  id         String   @id @default(cuid())
  userId     String
  txHash     String   @unique
  chainId    String
  fromToken  String
  toToken    String
  fromAmount String
  toAmount   String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// =====================================================================
// Social models (PR #9)
//
// Twitter-style flat thread model:
//   - Post is the only content unit; replies are Posts with parentPostId.
//   - This keeps queries simple (one table, one cursor) and lets us add
//     quote/repost cheaply later.
//
// Cursor pagination: order by (createdAt DESC, id DESC); cursor = id.
// =====================================================================

model Post {
  id           String    @id @default(cuid())
  authorId     String?
  body         String    @db.VarChar(2000)
  // Self-join: null = root post, non-null = reply to that post.
  parentPostId String?
  // mediaUrl reserved for PR #10 (media upload). Kept now to avoid a
  // second migration when uploads land.
  mediaUrl     String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  author  User?  @relation("PostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  parent  Post?  @relation("PostReplies", fields: [parentPostId], references: [id], onDelete: SetNull)
  replies Post[] @relation("PostReplies")
  likes   Like[]

  // Feed cursor: newest-first by (createdAt, id).
  @@index([createdAt, id])
  // Author's own timeline.
  @@index([authorId, createdAt])
  // Reply lookups for a given thread.
  @@index([parentPostId, createdAt])
}

model Follow {
  followerId String
  followeeId String
  createdAt  DateTime @default(now())

  follower User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followee User @relation("Followee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@id([followerId, followeeId])
  @@index([followeeId, createdAt])
  @@index([followerId, createdAt])
}

model Like {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId, createdAt])
  @@index([postId, createdAt])
}

// =====================================================================
// Path C v2 data model (S2)
//
// These tables are additive and dormant until the later S3-S7 routes and
// workers ship. Privacy defaults are deliberately deny-by-default.
// See docs/adr/0001-path-c-v2-data-model.md.
// =====================================================================

enum ConsentAuditAction {
  GRANTED
  UPDATED
  REVOKED
  VERSION_RESET
}

enum EnsSubnameStatus {
  NOT_REQUESTED
  PENDING
  ISSUED
  FAILED
}

enum QuestType {
  QUIZ
  TRANSACTION
}

enum QuestStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum QuestCompletionStatus {
  STARTED
  SUBMITTED
  VERIFIED
  REJECTED
}

enum SegmentStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SegmentAssignmentSource {
  INDEXER
  MANUAL
}

enum AdvertiserStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

model UserConsent {
  userId            String    @id
  consentVersion    String?   @db.VarChar(50)
  termsAcceptedAt   DateTime?
  privacyAcceptedAt DateTime?
  segmentingOptIn   Boolean   @default(false)
  marketingOptIn    Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserConsentAudit {
  id                String             @id @default(cuid())
  userId            String
  action            ConsentAuditAction
  consentVersion    String?            @db.VarChar(50)
  segmentingOptIn   Boolean            @default(false)
  marketingOptIn    Boolean            @default(false)
  termsAcceptedAt   DateTime?
  privacyAcceptedAt DateTime?
  createdAt         DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Quest {
  id                    String      @id @default(cuid())
  campaignId            String?
  slug                  String      @unique @db.VarChar(100)
  title                 String      @db.VarChar(200)
  description           String      @db.VarChar(2000)
  type                  QuestType
  status                QuestStatus @default(DRAFT)
  rewardOrange          Int         @default(0)
  requirements          Json
  requiresWalletSharing Boolean     @default(false)
  startsAt              DateTime?
  endsAt                DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  campaign    Campaign?         @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  completions QuestCompletion[]

  @@index([status, startsAt, endsAt])
  @@index([campaignId, status])
}

model QuestCompletion {
  id                       String                @id @default(cuid())
  questId                  String
  userId                   String
  status                   QuestCompletionStatus @default(STARTED)
  verifyProof              Json?
  walletSharingOptIn       Boolean               @default(false)
  walletSharingConsentedAt DateTime?
  submittedAt              DateTime?
  verifiedAt               DateTime?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  quest Quest @relation(fields: [questId], references: [id], onDelete: Restrict)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([questId, userId])
  @@index([questId, status])
  @@index([userId, createdAt])
}

model Segment {
  id          String        @id @default(cuid())
  slug        String        @unique @db.VarChar(100)
  name        String        @db.VarChar(200)
  description String?       @db.VarChar(2000)
  status      SegmentStatus @default(DRAFT)
  ruleVersion Int           @default(1)
  rule        Json
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  users     UserSegment[]
  campaigns Campaign[]

  @@index([status, updatedAt])
}

model UserSegment {
  userId      String
  segmentId   String
  source      SegmentAssignmentSource @default(INDEXER)
  ruleVersion Int
  matchedAt   DateTime                @default(now())
  expiresAt   DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  segment Segment @relation(fields: [segmentId], references: [id], onDelete: Restrict)

  @@id([userId, segmentId])
  @@index([segmentId, matchedAt])
  @@index([userId, expiresAt])
}

model Advertiser {
  id        String           @id @default(cuid())
  slug      String           @unique @db.VarChar(100)
  name      String           @db.VarChar(200)
  status    AdvertiserStatus @default(DRAFT)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  campaigns Campaign[]
}

model Campaign {
  id              String         @id @default(cuid())
  advertiserId    String
  targetSegmentId String?
  slug            String         @unique @db.VarChar(100)
  name            String         @db.VarChar(200)
  status          CampaignStatus @default(DRAFT)
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  advertiser    Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Restrict)
  targetSegment Segment?   @relation(fields: [targetSegmentId], references: [id], onDelete: Restrict)
  quests        Quest[]

  @@index([advertiserId, status])
  @@index([targetSegmentId, status])
  @@index([status, startsAt, endsAt])
}
